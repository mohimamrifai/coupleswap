---
const steps = [
	{ num: 1, desc: 'Sign up in minutes. Couples can build a joint profile to showcase their personality together, while singles create their own to connect with amazing pairs.' },
	{ num: 2, desc: 'Every member—whether part of a couple or single—completes a quick and secure verification. This is our non-negotiable commitment to a safe, authentic community.' },
	{ num: 3, desc: 'Browse verified profiles of non-monogamous couples and lifestyle singles near you. Filter by interests, desires, and location to find your perfect match.' },
	{ num: 4, desc: 'Once you find a match, use our secure messaging system to chat, share private photos, and plan your next adventure in the lifestyle.' },
];
---
<section class="process" id="how-it-works">
	<div class="process-inner">
		<div class="badge">
			<span class="badge-dot"></span>
			<span>Simple Process</span>
		</div>
		<h2 class="section-title">Your Journey to Connection.</h2>
		<p class="section-description">
			Get started in just four easy steps
		</p>
		<div class="steps-row">
			{steps.map((step) => (
				<div class="step">
					<div class="step-node">
						<span class="step-num">{step.num}</span>
					</div>
					<p class="step-desc">{step.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.process {
		padding: 4rem 1.5rem;
	}
	.process-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: #1a1520;
		border-radius: 9999px;
		font-size: 0.875rem;
		font-weight: 500;
		color: #fff;
		margin-bottom: 1rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ec4899;
	}
	.process .section-title {
		margin: 0 0 1rem;
		font-family: 'Inter', sans-serif;
		font-weight: 700;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
		color: #fff;
	}
	.section-description {
		margin: 0 0 4rem;
		font-family: 'Inter', sans-serif;
		font-weight: 400;
		font-size: 1.125rem;
		line-height: 1.6;
		text-align: center;
		color: rgba(255, 255, 255, 0.8);
		max-width: 600px;
	}
	.steps-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		width: 100%;
		gap: 2rem;
	}
	.step {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		position: relative;
		min-width: 0;
	}
	.step:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 28px;
		left: calc(50% + 28px);
		width: calc(100% - 28px);
		height: 2px;
		background-image: linear-gradient(to right, #E3449B 50%, rgba(255, 255, 255, 0) 0%);
		background-position: bottom;
		background-size: 14px 2px;
		background-repeat: repeat-x;
		z-index: 1;
	}
	.step-node {
		width: 56px;
		height: 56px;
		border-radius: 12px;
		background: linear-gradient(135deg, #E3449B 0%, #6E2CA1 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
		flex-shrink: 0;
		box-shadow: 0 4px 20px rgba(227, 68, 155, 0.4);
		position: relative;
		z-index: 2;
	}
	.step-num {
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
	}
	.step-desc {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.75);
		width: 100%;
		padding: 0 0.5rem;
	}
	@media (max-width: 900px) {
		.steps-row {
			flex-direction: column;
			align-items: flex-start;
			padding-left: 2rem;
			gap: 2rem;
		}
		.step {
			flex-direction: row;
			align-items: flex-start;
			text-align: left;
			width: 100%;
			max-width: none;
			min-width: 0;
		}
		.step:not(:last-child)::after {
			display: none;
		}
		.step-node {
			margin-bottom: 0;
			margin-right: 1rem;
		}
		.step-desc {
			width: 100%;
			max-width: none;
			padding-top: 0;
			padding-left: 0;
		}
	}
</style>
