---
import SealCheck from '../assets/SealCheck.webp';
import SparkleIcon from '../assets/Sparkle.webp';
import ChatsTeardropIcon from '../assets/ChatsTeardrop.webp';
import StarIcon from '../assets/Star.webp';
import UsersThreeIcon from '../assets/UsersThree.webp';
import ChartBarIcon from '../assets/ChartBar.webp';
import MedalIcon from '../assets/Medal.webp';

const features = [
	{
		title: 'AI-Powered Matching',
		desc: 'Our advanced AI analyzes compatibility across interests, location, preferences, and lifestyle goals to suggest your perfect matches.',
		icon: SparkleIcon,
		list: [
			'Smart compatibility scores',
			'Personalized recommendations',
			'Learning algorithm'
		]
	},
	{
		title: 'Real-Time Messaging',
		desc: 'Secure, encrypted messaging with read receipts, typing indicators, and the ability to share private photos with approved matches.',
		icon: ChatsTeardropIcon,
		list: [
			'End-to-end encryption',
			'Private photo sharing',
			'Match-only messaging'
		]
	},
	{
		title: 'Reviews & Ratings',
		desc: 'Build trust in the community with verified reviews and ratings from real experiences with other members.',
		icon: StarIcon,
		list: [
			'Verified attendee badges',
			'Anonymous reviews',
			'Community safety'
		]
	},
	{
		title: 'Partner Invites',
		desc: 'Couples can seamlessly invite and link their partners to create a unified profile showcasing both personalities.',
		icon: UsersThreeIcon,
		list: [
			'Joint profile creation',
			'Synchronized updates',
			'Couple verification'
		]
	},
	{
		title: 'Profile Analytics',
		desc: "Track who's viewing your profile, engagement rates, and get insights to optimize your presence on the platform.",
		icon: ChartBarIcon,
		list: [
			'View tracking',
			'Engagement metrics',
			'Growth suggestions'
		]
	},
	{
		title: 'Credit & Reward System',
		desc: 'Earn credits through verification, referrals, and engagement. Use credits for premium features and event access.',
		icon: MedalIcon,
		list: [
			'Referral rewards',
			'Profile completion bonus',
			'Event discounts'
		]
	},
];

---
<section class="authentic-features" id="authentic-features">
	<div class="section-inner">
		<div class="badge" data-aos="fade-down">
			<span class="badge-dot"></span>
			<span>Powerful Features</span>
		</div>
		<h2 class="section-title" data-aos="fade-up">Built With You in Mind.</h2>
		<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">Every feature designed to make your lifestyle journey safer, easier, and more exciting.</p>
		<div class="grid desktop-grid">
			{features.map((f, index) => (
				<div class="card" data-aos="fade-up" data-aos-delay={index * 100 + 200}>
					<div class="card-icon">
						<img src={f.icon.src} alt={f.title} class="feature-icon-img" />
					</div>
					<h3 class="card-title">{f.title}</h3>
					<p class="card-desc">{f.desc}</p>
					<ul class="feature-list">
						{f.list.map((item) => (
							<li class="feature-item">
								<div class="check-icon-wrapper">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4">
										<polyline points="20 6 9 17 4 12" />
									</svg>
								</div>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
		<div class="features-swiper">
			<div class="swiper authentic-swiper">
				<div class="swiper-wrapper">
					{features.map((f) => (
						<div class="swiper-slide">
							<div class="card">
								<div class="card-icon">
									<img src={f.icon.src} alt={f.title} class="feature-icon-img" />
								</div>
								<h3 class="card-title">{f.title}</h3>
								<p class="card-desc">{f.desc}</p>
								<ul class="feature-list">
									{f.list.map((item) => (
										<li class="feature-item">
											<div class="check-icon-wrapper">
												<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4">
													<polyline points="20 6 9 17 4 12" />
												</svg>
											</div>
											<span>{item}</span>
										</li>
									))}
								</ul>
							</div>
						</div>
					))}
				</div>
				<div class="swiper-pagination"></div>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		if (window.Swiper) {
			new Swiper('.authentic-swiper', {
				slidesPerView: 1,
				spaceBetween: 16,
				pagination: {
					el: '.authentic-swiper .swiper-pagination',
					clickable: true,
				},
			});
		}
	});
</script>

<style>
	.authentic-features {
		padding: 4rem 1.5rem;
	}
	.section-inner {
		max-width: 1200px;
		margin: 0 auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: #1a1520;
		border-radius: 9999px;
		font-size: 0.875rem;
		font-weight: 500;
		color: #fff;
		margin-bottom: 1rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ec4899;
	}
	.authentic-features .section-title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 700;
		color: #fff;
		letter-spacing: -0.02em;
	}
	.authentic-features .section-subtitle {
		margin: 0 0 2.5rem;
		font-size: 1.0625rem;
		color: rgba(255, 255, 255, 0.75);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		text-align: left;
		width: 100%;
	}
	.card {
		padding: 2rem;
		background: #0d0d0d;
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 24px;
		transition: border-color 0.2s, transform 0.2s;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		position: relative;
		overflow: hidden;
	}
	.card:hover {
		border-color: rgba(168, 85, 247, 0.25);
		transform: translateY(-2px);
	}
	.card-icon {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(296.38deg, #6E2CA1 5.71%, #E3449B 88.36%);
		border-radius: 50%;
		margin-bottom: 1.5rem;
	}
	.feature-icon-img {
		width: 24px;
		height: 24px;
		object-fit: contain;
		filter: brightness(0) invert(1);
	}
	.card-title {
		margin: 0 0 1rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: #fff;
		font-family: 'Inter', sans-serif;
	}
	.card-desc {
		margin: 0 0 2rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.6);
		font-family: 'Inter', sans-serif;
	}
	.feature-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}
	.feature-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.875rem;
		color: #fff;
		font-weight: 500;
	}
	.check-icon-wrapper {
		width: 20px;
		height: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background: linear-gradient(296.38deg, #6E2CA1 5.71%, #E3449B 88.36%);
		border-radius: 50%;
	}
	.check-icon {
		width: 12px;
		height: 12px;
		object-fit: contain;
		filter: brightness(0) invert(1);
	}
	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	
	.features-swiper {
		display: none;
		width: 100%;
	}
	.authentic-swiper {
		width: 100%;
		padding-bottom: 2rem;
	}

	@media (max-width: 640px) {
		.grid.desktop-grid {
			display: none;
		}
		.features-swiper {
			display: block;
		}
	}
</style>

<style is:global>
	.authentic-swiper {
		--swiper-pagination-color: #ec4899;
		--swiper-pagination-bullet-inactive-color: #ffffff;
		--swiper-pagination-bullet-inactive-opacity: 0.3;
		--swiper-pagination-bullet-size: 10px;
		--swiper-pagination-bullet-horizontal-gap: 6px;
	}

	.authentic-swiper .swiper-pagination-bullet {
		background: var(--swiper-pagination-bullet-inactive-color) !important;
		opacity: var(--swiper-pagination-bullet-inactive-opacity) !important;
		width: var(--swiper-pagination-bullet-size) !important;
		height: var(--swiper-pagination-bullet-size) !important;
		margin: 0 var(--swiper-pagination-bullet-horizontal-gap) !important;
		transition: all 0.3s ease;
	}

	.authentic-swiper .swiper-pagination-bullet-active {
		background: var(--swiper-pagination-color) !important;
		opacity: 1 !important;
		width: 24px !important;
		border-radius: 5px !important;
	}
</style>
