---
import travelImage from '../assets/travel-image.webp';

const travelFeatures = [
	{
		title: 'Group Trip Planning',
		desc: 'Plan and join lifestyle trips with verified members. From resort takeovers to exotic destinations, create unforgettable experiences with like-minded adventurers.'
	},
	{
		title: 'Discover Destinations',
		desc: 'Browse upcoming trips or create your own adventure'
	},
	{
		title: 'Verified Travelers Only',
		desc: 'All trip participants are verified members'
	}
];
---
<section class="travel" id="travel">
	<div class="travel-inner">
		<div class="travel-content">
			<div class="badge" data-aos="fade-down">
				<span class="badge-dot"></span>
				<span>Powerful Features</span>
			</div>
			<h2 class="section-title" data-aos="fade-up">Travel Together <br /> <span class="text-gradient">Explore the World.</span></h2>
			<p class="section-desc" data-aos="fade-up" data-aos-delay="100">
				Plan and join lifestyle trips with verified members. From resort takeovers to exotic destinations, create unforgettable experiences with like-minded adventurers.
			</p>
			
			<div class="feature-list">
				{travelFeatures.map((feature, index) => (
					<div class="feature-item" data-aos="fade-up" data-aos-delay={index * 100 + 200}>
						<div class="check-icon-wrapper">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
								<polyline points="20 6 9 17 4 12" />
							</svg>
						</div>
						<div class="feature-text">
							<h3 class="feature-title">{feature.title}</h3>
							<p class="feature-desc">{feature.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
		<div class="travel-image-col" data-aos="fade-left" data-aos-delay="300">
			<img src={travelImage.src} alt="Travel Destination" class="destination-image" />
		</div>
	</div>
</section>

<style>
	.travel {
		padding: 6rem 1.5rem;
		background: #0a0a0a;
	}
	.travel-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}
	.travel-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: #1a1520;
		border-radius: 9999px;
		font-size: 0.875rem;
		font-weight: 500;
		color: #fff;
		margin-bottom: 1.5rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ec4899;
	}
	.section-title {
		margin: 0 0 1.5rem;
		font-family: 'Inter', sans-serif;
		font-weight: 700;
		font-size: 40px;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #fff;
	}
	.text-gradient {
		background: linear-gradient(296.38deg, #6E2CA1 5.71%, #E3449B 88.36%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		color: transparent;
	}
	.section-desc {
		margin: 0 0 3rem;
		font-family: 'Inter', sans-serif;
		font-weight: 400;
		font-size: 16px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
	}
	.feature-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.feature-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}
	.check-icon-wrapper {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		border-radius: 50%;
		background: linear-gradient(296.38deg, #6E2CA1 5.71%, #E3449B 88.36%);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 0.25rem;
	}
	.check-icon {
		width: 14px;
		height: 14px;
		color: #fff;
	}
	.feature-text {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.feature-title {
		margin: 0;
		font-family: 'Inter', sans-serif;
		font-weight: 500;
		font-size: 24px;
		line-height: 100%;
		letter-spacing: 0%;
		color: #fff;
	}
	.feature-desc {
		margin: 0;
		font-family: 'Inter', sans-serif;
		font-weight: 400;
		font-size: 18px;
		line-height: 140%;
		letter-spacing: -0.03em;
		color: rgba(255, 255, 255, 0.7);
	}

	.travel-image-col {
		display: flex;
		justify-content: flex-end;
		width: 100%;
	}
	.destination-image {
		width: 100%;
		max-width: 600px;
		height: auto;
		object-fit: cover;
	}

	@media (max-width: 900px) {
		.travel-inner {
			grid-template-columns: 1fr;
			text-align: left;
		}
		.travel-content {
			align-items: flex-start;
		}
		.section-title {
			font-size: 28px;
		}
		.section-desc {
			font-size: 14px;
		}
		.travel-image-col {
			justify-content: center;
			margin-top: 2rem;
		}
		.feature-item {
			align-items: flex-start;
		}
		.feature-title {
			font-size: 16px;
		}
		.feature-desc {
			font-size: 13px;
		}
	}
</style>
