---
import logoImage from '../assets/logo.webp';
---
<header class="navbar">
	<div class="navbar-inner">
		<a href="/" class="logo">
			<img src={logoImage.src} alt="CoupleSwap" width={logoImage.width} height={logoImage.height} class="logo-img" />
		</a>
		<button type="button" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
			<span class="hamburger"></span>
		</button>
		<div class="nav-dropdown" id="nav-menu">
			<button type="button" class="close-toggle" aria-label="Close menu" aria-controls="nav-menu">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18" />
					<line x1="6" y1="6" x2="18" y2="18" />
				</svg>
			</button>
			<nav class="nav-links">
				<a href="#features">Features</a>
				<a href="#how-it-works">How it works</a>
				<a href="#pricing">Pricing</a>
			</nav>
			<div class="nav-actions">
				<a href="#login" class="btn btn-ghost">Login</a>
				<a href="#join" class="btn btn-primary">Sign Up</a>
			</div>
		</div>
	</div>
</header>

<script>
	function closeMenu() {
		const dropdown = document.getElementById('nav-menu');
		const toggleBtn = document.querySelector('.menu-toggle');
		if (!dropdown || !toggleBtn) return;
		dropdown.classList.remove('open');
		toggleBtn.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}
	function updateNavbarBackground() {
		const navbar = document.querySelector('.navbar');
		if (!navbar) return;
		if (window.scrollY > 0) {
			navbar.classList.add('scrolled');
		} else {
			navbar.classList.remove('scrolled');
		}
	}
	updateNavbarBackground();
	window.addEventListener('scroll', updateNavbarBackground);
	document.querySelector('.menu-toggle')?.addEventListener('click', () => {
		const dropdown = document.getElementById('nav-menu');
		const btn = document.querySelector('.menu-toggle');
		if (!dropdown || !btn) return;
		const open = dropdown.classList.toggle('open');
		btn.setAttribute('aria-expanded', String(open));
		document.body.style.overflow = open ? 'hidden' : '';
	});
	document.querySelector('.close-toggle')?.addEventListener('click', closeMenu);
	document.querySelectorAll('#nav-menu a').forEach((a) => {
		a.addEventListener('click', closeMenu);
	});
</script>

<style>
	.navbar {
		background: transparent;
		padding: 1rem 1.5rem;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		border-bottom: none;
		width: 100%;
		box-sizing: border-box;
	}
	.navbar.scrolled {
		background: #000;
	}
	.navbar-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		position: relative;
	}
	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo-img {
		width: 258px;
		height: 40px;
		opacity: 1;
		display: block;
		object-fit: contain;
	}
	.nav-dropdown {
		display: flex;
		align-items: center;
		gap: 2rem;
		flex: 1;
	}
	.nav-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		flex: 1;
	}
	.nav-links a {
		color: #fff;
		text-decoration: none;
		font-family: Inter, sans-serif;
		font-weight: 400;
		font-style: normal;
		font-size: 16px;
		line-height: 100%;
		letter-spacing: -0.02em;
		vertical-align: middle;
		opacity: 0.9;
	}
	.nav-links a:hover {
		opacity: 1;
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 120px;
		height: 50px;
		padding: 14px;
		border-radius: 8px;
		border-width: 1px;
		border-style: solid;
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		opacity: 1;
		transition: opacity 0.2s;
		box-sizing: border-box;
	}
	.btn:hover {
		opacity: 0.9;
	}
	.btn-ghost {
		background: #FFFFFF1A;
		color: #fff;
		border-color: rgba(255, 255, 255, 0.1);
	}
	.btn-primary {
		background: linear-gradient(279.9deg, #6E2CA1 -34.31%, #E3449B 100%);
		color: #fff;
		border-color: transparent;
	}
	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		cursor: pointer;
		color: #fff;
	}
	.hamburger {
		width: 20px;
		height: 2px;
		background: currentColor;
		position: relative;
		transition: background 0.2s;
	}
	.hamburger::before,
	.hamburger::after {
		content: '';
		position: absolute;
		left: 0;
		width: 20px;
		height: 2px;
		background: currentColor;
		transition: transform 0.2s;
	}
	.hamburger::before {
		top: -6px;
	}
	.hamburger::after {
		top: 6px;
	}
	.menu-toggle[aria-expanded="true"] .hamburger {
		background: transparent;
	}
	.menu-toggle[aria-expanded="true"] .hamburger::before {
		transform: translateY(6px) rotate(45deg);
	}
	.menu-toggle[aria-expanded="true"] .hamburger::after {
		transform: translateY(-6px) rotate(-45deg);
	}
	.close-toggle {
		display: none;
	}
	@media (max-width: 768px) {
		.navbar {
			padding: 0.75rem 1rem;
			width: 100%;
			box-sizing: border-box;
		}
		.navbar-inner {
			gap: 0.5rem;
		}
		.logo-img {
			width: 180px;
			height: 28px;
		}
		.menu-toggle {
			display: flex;
			flex-shrink: 0;
		}
		.nav-dropdown {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(10, 10, 10, 0.98);
			flex-direction: column;
			align-items: stretch;
			justify-content: center;
			gap: 0;
			padding: 5rem 1.5rem 2rem;
			z-index: 99;
			overflow-y: auto;
		}
		.nav-dropdown.open {
			display: flex;
		}
		.close-toggle {
			display: flex;
			position: absolute;
			top: 1rem;
			right: 1rem;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			padding: 0;
			background: rgba(255, 255, 255, 0.08);
			border: 1px solid rgba(255, 255, 255, 0.1);
			border-radius: 10px;
			color: #fff;
			cursor: pointer;
			transition: background 0.2s, opacity 0.2s;
		}
		.close-toggle:hover {
			background: rgba(255, 255, 255, 0.12);
		}
		.nav-dropdown .nav-links {
			flex-direction: column;
			gap: 0;
			padding: 0;
			align-items: center;
		}
		.nav-dropdown .nav-links a {
			padding: 1rem;
			font-size: 1.125rem;
			width: 100%;
			text-align: center;
		}
		.nav-dropdown .nav-actions {
			flex-direction: column;
			gap: 0.75rem;
			padding: 1.5rem 0 0;
			margin-top: 0.5rem;
			border-top: 1px solid rgba(255, 255, 255, 0.1);
			align-items: stretch;
		}
		.nav-dropdown .btn {
			width: 100%;
			max-width: 280px;
			margin: 0 auto;
		}
	}
</style>
