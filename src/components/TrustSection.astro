---
import shieldCheckImage from '../assets/ShieldCheck.webp';
import heartImage from '../assets/Heart.webp';
import compassImage from '../assets/Compass.webp';
import lockImage from '../assets/Lock.webp';

const features = [
	{
		icon: shieldCheckImage,
		title: 'Verified & Safe',
		description: 'Our industry-leading verification is mandatory for everyone. Whether you\'re a couple or a single, connect with confidence knowing every member is real.'
	},
	{
		icon: heartImage,
		title: 'Couple-Centric by Design',
		description: 'Our platform is built to empower couples on their lifestyle journey. Vetted singles are welcome to join and connect.'
	},
	{
		icon: compassImage,
		title: 'Discover & Connect',
		description: 'Find local swinger couples and singles, plan discreet meetups, or join exciting lifestyle events.'
	},
	{
		icon: lockImage,
		title: 'Total Privacy',
		description: 'Your discretion is our priority. With private photo albums and robust privacy controls, you decide who sees what.'
	},
];
---
<section class="trust" id="features">
	<div class="trust-inner">
		<div class="badge" data-aos="fade-down">
			<span class="badge-dot"></span>
			<span>Why Choose Us</span>
		</div>
		<h2 class="section-title" data-aos="fade-up">5,000 Couples <br/> Trust CoupleSwap.</h2>
		<p class="section-description" data-aos="fade-up" data-aos-delay="100">
			Real profiles, safer fun, no surprises—real, safe, and private.
		</p>
		<div class="features-grid desktop-grid">
			{features.map((feature, index) => (
				<div class="feature-card" data-aos="fade-up" data-aos-delay={index * 100 + 200}>
					<div class="feature-icon-wrapper">
						<img src={feature.icon.src} width="32" height="32" alt={feature.title} class="feature-icon" />
					</div>
					<h3 class="feature-title">{feature.title}</h3>
					<p class="feature-description">{feature.description}</p>
				</div>
			))}
		</div>
		<div class="features-swiper">
			<div class="swiper trust-swiper">
				<div class="swiper-wrapper">
					{features.map((feature) => (
						<div class="swiper-slide">
							<div class="feature-card">
								<div class="feature-icon-wrapper">
									<img src={feature.icon.src} width="32" height="32" alt={feature.title} class="feature-icon" />
								</div>
								<h3 class="feature-title">{feature.title}</h3>
								<p class="feature-description">{feature.description}</p>
							</div>
						</div>
					))}
				</div>
				<div class="swiper-pagination"></div>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		if (window.Swiper) {
			new Swiper('.trust-swiper', {
				slidesPerView: 1,
				spaceBetween: 16,
				pagination: {
					el: '.trust-swiper .swiper-pagination',
					clickable: true,
				},
			});
		}
	});
</script>

<style>
	.trust {
		padding: 4rem 1.5rem;
		background: #0a0a0a;
		scroll-margin-top: 100px;
	}
	.trust-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: #1a1520;
		border-radius: 9999px;
		font-size: 0.875rem;
		font-weight: 500;
		color: #fff;
		margin-bottom: 1rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ec4899;
	}
	.trust .section-title {
		margin: 0 0 1rem;
		font-family: 'Inter', sans-serif;
		font-weight: 700;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
		color: #fff;
	}
	.section-description {
		margin: 0 0 4rem;
		font-family: 'Inter', sans-serif;
		font-weight: 400;
		font-size: 1.125rem;
		line-height: 1.6;
		text-align: center;
		color: rgba(255, 255, 255, 0.8);
		max-width: 600px;
	}
	.features-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		width: 100%;
	}
	.features-swiper {
		display: none;
		width: 100%;
	}
	.trust-swiper {
		width: 100%;
		padding-bottom: 2rem;
	}
	.feature-card {
		background: #FFFFFF05;
		border: 1px solid #2C303A4D;
		border-radius: 24px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		transition: transform 0.2s;
	}
	.feature-card:hover {
		transform: translateY(-4px);
	}
	.feature-icon-wrapper {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
		box-shadow: 0 4px 20px rgba(236, 72, 153, 0.3);
	}
	.feature-icon {
		width: 28px;
		height: 28px;
		object-fit: contain;
		filter: brightness(0) invert(1);
	}
	.feature-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: #fff;
		margin: 0 0 0.75rem;
		line-height: 1.3;
	}
	.feature-description {
		font-family: 'Inter', sans-serif;
		font-weight: 400;
		font-size: 16px;
		line-height: 140%;
		letter-spacing: -0.02em;
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
	}
	@media (max-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 640px) {
		.features-grid.desktop-grid {
			display: none;
		}
		.features-swiper {
			display: block;
		}
		.features-grid {
			grid-template-columns: 1fr;
		}
		.feature-card {
			padding: 1.5rem;
		}
	}
</style>

<style is:global>
	.trust-swiper {
		--swiper-pagination-color: #ec4899;
		--swiper-pagination-bullet-inactive-color: #ffffff;
		--swiper-pagination-bullet-inactive-opacity: 0.3;
		--swiper-pagination-bullet-size: 10px;
		--swiper-pagination-bullet-horizontal-gap: 6px;
	}

	.trust-swiper .swiper-pagination-bullet {
		background: var(--swiper-pagination-bullet-inactive-color) !important;
		opacity: var(--swiper-pagination-bullet-inactive-opacity) !important;
		width: var(--swiper-pagination-bullet-size) !important;
		height: var(--swiper-pagination-bullet-size) !important;
		margin: 0 var(--swiper-pagination-bullet-horizontal-gap) !important;
		transition: all 0.3s ease;
	}

	.trust-swiper .swiper-pagination-bullet-active {
		background: var(--swiper-pagination-color) !important;
		opacity: 1 !important;
		width: 24px !important;
		border-radius: 5px !important;
	}
</style>
