---
import logoImage from '../assets/logo.webp';
import facebookIcon from '../assets/facebook.png';
---
<footer class="footer" id="footer">
	<div class="footer-inner">
		<div class="footer-top">
			<div class="brand">
				<a href="/" class="logo-link">
					<img src={logoImage.src} alt="CoupleSwap" class="logo-img" />
				</a>
				<p class="tagline">The trusted platform for verified couples and singles to safely explore the lifestyle together.</p>
				<div class="social">
					<a href="#instagram" aria-label="Instagram">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M7.8 2H16.2C19.4 2 22 4.6 22 7.8V16.2C22 19.4 19.4 22 16.2 22H7.8C4.6 22 2 19.4 2 16.2V7.8C2 4.6 4.6 2 7.8 2ZM7.6 4C5.5 4 4 5.5 4 7.6V16.4C4 18.5 5.5 20 7.6 20H16.4C18.5 20 20 18.5 20 16.4V7.6C20 5.5 18.5 4 16.4 4H7.6ZM17.25 5.5C17.9404 5.5 18.5 6.05964 18.5 6.75C18.5 7.44036 17.9404 8 17.25 8C16.5596 8 16 7.44036 16 6.75C16 6.05964 16.5596 5.5 17.25 5.5ZM12 7C14.7614 7 17 9.23858 17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7ZM12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9Z"/></svg>
					</a>
					<a href="#facebook" aria-label="Facebook">
						<img src={facebookIcon.src} width="24" height="24" alt="Facebook" style="object-fit: contain;" />
					</a>
					<a href="#linkedin" aria-label="LinkedIn">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.5 2H3.5C2.67157 2 2 2.67157 2 3.5V20.5C2 21.3284 2.67157 22 3.5 22H20.5C21.3284 22 22 21.3284 22 20.5V3.5C22 2.67157 21.3284 2 20.5 2ZM8 19H5V8H8V19ZM6.5 6.73269C5.53447 6.73269 4.75 5.94819 4.75 4.98269C4.75 4.01719 5.53447 3.23269 6.5 3.23269C7.46553 3.23269 8.25 4.01719 8.25 4.98269C8.25 5.94819 7.46553 6.73269 6.5 6.73269ZM20 19H17V13.5613C17 12.2618 16.9641 10.5821 15.175 10.5821C13.3571 10.5821 13.0781 11.9962 13.0781 13.4663V19H10.0781V8H12.9219V9.29688H13.0781C13.4734 8.54906 14.4414 7.75938 15.8805 7.75938C18.875 7.75938 19.4336 9.73125 19.4336 12.3281V19H20Z"/></svg>
					</a>
					<a href="#youtube" aria-label="YouTube">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.18C23.252 5.269 22.535 4.55 21.622 4.305C19.965 3.86 12 3.86 12 3.86C12 3.86 4.035 3.86 2.378 4.305C1.465 4.55 0.748 5.269 0.502 6.18C0.262 7.841 0.262 11.305 0.262 11.305C0.262 11.305 0.262 14.769 0.502 16.43C0.748 17.341 1.465 18.06 2.378 18.305C4.035 18.75 12 18.75 12 18.75C12 18.75 19.965 18.75 21.622 18.305C22.535 18.06 23.252 17.341 23.498 16.43C23.738 14.769 23.738 11.305 23.738 11.305C23.738 11.305 23.738 7.841 23.498 6.18ZM9.545 15.568V7.042L15.955 11.305L9.545 15.568Z"/></svg>
					</a>
				</div>
			</div>
			
			<div class="footer-nav">
				<div class="col">
					<h4 class="col-title">Menu</h4>
					<a href="#features">Features</a>
					<a href="#how-it-works">How it Works</a>
					<a href="#pricing">Pricing</a>
				</div>
				<div class="col">
					<h4 class="col-title">Company</h4>
					<a href="#about">About Us</a>
					<a href="#safety">Safety</a>
					<a href="#contact">Contact</a>
				</div>
				<div class="col">
					<h4 class="col-title">Headquarters</h4>
					<p class="address">1341 Poplar Street,<br/>Chicago, IL 60606</p>
					<p class="phone">(785) 712-6532</p>
				</div>
			</div>

			<button id="scrollTopBtn" class="scroll-top" aria-label="Scroll to top">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="19" x2="12" y2="5"></line>
					<polyline points="5 12 12 5 19 12"></polyline>
				</svg>
			</button>
		</div>

		<div class="footer-bottom">
			<div class="bottom-legal">
				<a href="#privacy">Privacy Policy</a>
				<span class="dot">•</span>
				<a href="#terms">Term of Conditions</a>
			</div>

			<p class="copyright">© 2025 CoupleSwap. All content is protected and created by its users. 18+ only.</p>
		</div>
	</div>
</footer>

<script>
	const scrollTopBtn = document.getElementById('scrollTopBtn');
	
	if (scrollTopBtn) {
		// Show button after scrolling down 2 sections (approx 200vh)
		window.addEventListener('scroll', () => {
			if (window.scrollY > window.innerHeight * 2) {
				scrollTopBtn.classList.add('visible');
			} else {
				scrollTopBtn.classList.remove('visible');
			}
		});

		scrollTopBtn.addEventListener('click', () => {
			window.scrollTo({
				top: 0,
				behavior: 'smooth'
			});
		});
	}
</script>

<style>
	.footer {
		background: #0a0a0a;
		padding: 5rem 1.5rem 2rem;
		color: #fff;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		position: relative;
		overflow: hidden;
	}
	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 4rem;
		margin-bottom: 4rem;
	}
	.brand {
		max-width: 300px;
	}
	.logo-link {
		display: inline-block;
		margin-bottom: 1.5rem;
	}
	.logo-img {
		height: 32px;
		width: auto;
		object-fit: contain;
	}
	.tagline {
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 2rem;
	}
	
	.footer-nav {
		display: flex;
		gap: 4rem;
		flex: 1;
		justify-content: center;
		margin: 0 4rem;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.col-title {
			font-size: 1rem;
			font-weight: 600;
			color: #fff;
			margin: 0 0 0.5rem;
			width: 100%;
		}
		.address {
			width: 100%;
		}
	.col a, .col p {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		line-height: 1.5;
		margin: 0;
	}
	.col a:hover {
		color: #fff;
	}
	
	.scroll-top {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		border: none;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background 0.2s, opacity 0.3s ease, visibility 0.3s ease;
		flex-shrink: 0;
		opacity: 0;
		visibility: hidden;
	}
	.scroll-top.visible {
		opacity: 1;
		visibility: visible;
	}
	.scroll-top:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.divider {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 4rem;
		opacity: 0.6;
	}
	.line {
		flex: 1;
		height: 1px;
		border-top: 1px dashed rgba(255, 255, 255, 0.2);
	}
	.divider-icon {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding-top: 2rem;
		margin-top: 2rem;
	}
	.social {
		display: flex;
		gap: 1rem;
	}
	.social a {
		color: rgba(255, 255, 255, 0.6);
		transition: color 0.2s;
	}
	.social a:hover {
		color: #fff;
		transform: translateY(-2px);
	}
	
	.bottom-legal {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.5);
	}
	.bottom-legal a {
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
	}
	.bottom-legal a:hover {
		color: #fff;
	}
	.dot {
		font-size: 0.5rem;
	}

	.copyright {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.4);
		margin: 0;
		text-align: right;
	}

	@media (max-width: 900px) {
		.footer-top {
			flex-direction: column;
			align-items: flex-start;
			text-align: left;
			gap: 3rem;
		}
		.brand {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
		}
		.footer-nav {
			width: 100%;
			margin: 0;
			justify-content: flex-start;
			flex-direction: column;
			gap: 1.5rem;
		}
		.col {
			align-items: flex-start;
			gap: 0.75rem;
		}
		.scroll-top {
			position: fixed;
			bottom: 2rem;
			right: 2rem;
			z-index: 50;
			background: rgba(255, 255, 255, 0.15);
			backdrop-filter: blur(10px);
			border: 1px solid rgba(255, 255, 255, 0.1);
			margin-top: 0;
			opacity: 0;
			visibility: hidden;
		}
		.scroll-top.visible {
			opacity: 1;
			visibility: visible;
		}
		.footer-inner {
			position: static;
		}
		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.5rem;
			text-align: left;
		}
		.social {
			justify-content: flex-start;
		}
		.bottom-legal {
			justify-content: flex-start;
		}
		.copyright {
			text-align: left;
		}
	}
</style>
